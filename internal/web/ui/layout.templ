package ui

templ Shell(title string, body string) {
    <!doctype html>
    <html lang="en" data-theme="funnel">
    <head>
        <meta charset="utf-8"/>
        <meta name="viewport" content="width=device-width, initial-scale=1"/>
        <meta name="color-scheme" content="light"/>
        <meta name="description" content="Tailnet-only control plane for private HTTPS exposure, signed ingress reports, and ownership-scoped DNS."/>
        <title>{ title } · Local Funnel</title>
        <link rel="icon" type="image/png" href="/assets/brand/local-funnel-logo.png"/>
        <link rel="stylesheet" href="/assets/app.css"/>
        <script src="/assets/htmx.min.js" defer></script>
    </head>
    <body>
        <div class="pf-app">
            <aside class="pf-sidebar" id="pf-sidebar">
                <div class="pf-brand"><img class="pf-brand-logo" src="/assets/brand/local-funnel-logo.png" alt="Local Funnel logo"/><span><strong>Local Funnel</strong><small>Tailscale private edge</small></span></div>
                <nav class="pf-nav" aria-label="Primary navigation">
                    <p class="pf-nav-label">Overview</p>
                    <a href="/" data-nav="/"><img src="/assets/icons/layout-dashboard.svg" alt=""/>Dashboard</a>
                    <a href="/exposures" data-nav="/exposures"><img src="/assets/icons/world.svg" alt=""/>Exposures</a>
                    <p class="pf-nav-label">Infrastructure</p>
                    <a href="/loadbalancers" data-nav="/loadbalancers"><img src="/assets/icons/server-2.svg" alt=""/>Load balancers</a>
                    <a href="/ingresses" data-nav="/ingresses"><img src="/assets/icons/route.svg" alt=""/>Ingress nodes</a>
                    <a href="/applications" data-nav="/applications"><img src="/assets/icons/server-2.svg" alt=""/>Applications</a>
                    <a href="/providers" data-nav="/providers"><img src="/assets/icons/database.svg" alt=""/>DNS providers</a>
                    <a href="/zones" data-nav="/zones"><img src="/assets/icons/link.svg" alt=""/>Zones</a>
                    <p class="pf-nav-label">Access</p>
                    <a href="/settings" data-nav="/settings"><img src="/assets/icons/settings.svg" alt=""/>Tailscale</a>
                    <a href="/access" data-nav="/access"><img src="/assets/icons/users.svg" alt=""/>Access roles</a>
                    <a href="/policies" data-nav="/policies"><img src="/assets/icons/shield-check.svg" alt=""/>Exposure policy</a>
                    <p class="pf-nav-label">Operations</p>
                    <a href="/operations" data-nav="/operations"><img src="/assets/icons/list-check.svg" alt=""/>Operations</a>
                </nav>
                <div class="pf-sidebar-footer"><a href="/operations"><img src="/assets/icons/book.svg" alt=""/>Documentation</a><a href="/settings"><img src="/assets/icons/help-circle.svg" alt=""/>Support & settings</a></div>
            </aside>
            <div class="pf-main">
                <header class="pf-topbar">
                    <button class="pf-menu" type="button" aria-label="Open navigation" aria-controls="pf-sidebar" aria-expanded="false" onclick="const open=this.getAttribute('aria-expanded') !== 'true'; document.getElementById('pf-sidebar').classList.toggle('pf-sidebar-open', open); this.setAttribute('aria-expanded', String(open)); this.setAttribute('aria-label', open ? 'Close navigation' : 'Open navigation')"><img src="/assets/icons/menu-2.svg" alt=""/></button>
                    <div class="pf-topbar-context"><span class="pf-kicker">Tailnet</span><strong>Local Funnel</strong><img src="/assets/icons/chevron-down.svg" alt=""/></div>
                    <div class="pf-topbar-right"><span class="pf-health"><i class="pf-status-dot pf-status-ok"></i> Control plane online</span><span class="pf-identity"><img src="/assets/icons/user-circle.svg" alt=""/> Control node</span></div>
                </header>
                <main class="pf-content" id="page-content">@templ.Raw(body)</main>
                <footer class="pf-footer"><span>Local Funnel · tailnet-only control plane</span><span><a href="/operations">Docs</a><a href="/settings">Settings</a></span></footer>
            </div>
        </div>
        <script>
        (function(){const path=window.location.pathname;document.querySelectorAll('[data-nav]').forEach(function(a){if(a.dataset.nav==='/'?path==='/':path===a.dataset.nav||path.startsWith(a.dataset.nav+'/'))a.classList.add('is-active')})})();
        </script>
    </body>
    </html>
}
