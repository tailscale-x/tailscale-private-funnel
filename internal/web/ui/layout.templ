package ui

templ Shell(title string, body string) {
    <!doctype html>
    <html lang="en" data-theme="funnel">
    <head>
        <meta charset="utf-8"/>
        <meta name="viewport" content="width=device-width, initial-scale=1"/>
        <meta name="color-scheme" content="light"/>
        <meta name="description" content="Tailnet-only control plane for private HTTPS exposure, signed gateway reports, and ownership-scoped DNS."/>
        <title>{ title } · Local Funnel</title>
        <link rel="icon" type="image/png" href="/assets/brand/local-funnel-logo.png"/>
        <link rel="stylesheet" href="/assets/app.css"/>
        <script src="/assets/htmx.min.js" defer></script>
    </head>
    <body>
        <a class="pf-skip-link" href="#page-content">Skip to content</a>
        <div class="pf-app">
            <aside class="pf-sidebar" id="pf-sidebar">
                <div class="pf-brand"><img class="pf-brand-logo" src="/assets/brand/local-funnel-logo.png" alt="Local Funnel logo"/><span><strong>Local Funnel</strong><small>Tailscale private edge</small></span></div>
                <nav class="pf-nav" aria-label="Primary navigation">
                    <p class="pf-nav-label">Overview</p>
                    <a href="/" data-nav="/"><img src="/assets/icons/layout-dashboard.svg" alt=""/>Dashboard</a>
                    <a href="/exposures" data-nav="/exposures"><img src="/assets/icons/world.svg" alt=""/>Exposures</a>
                    <p class="pf-nav-label">Infrastructure</p>
                    <a href="/loadbalancers" data-nav="/loadbalancers"><img src="/assets/icons/server-2.svg" alt=""/>Load balancers</a>
                    <a href="/gateways" data-nav="/gateways"><img src="/assets/icons/route.svg" alt=""/>Gateways</a>
                    <a href="/applications" data-nav="/applications"><img src="/assets/icons/server-2.svg" alt=""/>Applications</a>
                    <a href="/providers" data-nav="/providers"><img src="/assets/icons/database.svg" alt=""/>DNS providers</a>
                    <a href="/zones" data-nav="/zones"><img src="/assets/icons/link.svg" alt=""/>Zones</a>
                    <p class="pf-nav-label">Access</p>
                    <a href="/settings" data-nav="/settings"><img src="/assets/icons/settings.svg" alt=""/>Tailscale</a>
                    <a href="/access" data-nav="/access"><img src="/assets/icons/users.svg" alt=""/>Access roles</a>
                    <a href="/policies" data-nav="/policies"><img src="/assets/icons/shield-check.svg" alt=""/>Exposure policy</a>
                    <p class="pf-nav-label">Operations</p>
                    <a href="/operations" data-nav="/operations"><img src="/assets/icons/list-check.svg" alt=""/>Operations</a>
                </nav>
                <div class="pf-sidebar-footer"><a href="https://github.com/tailscale-x/tailscale-private-funnel/blob/main/PRIVATE_FUNNEL.md"><img src="/assets/icons/book.svg" alt=""/>Documentation</a><a href="https://github.com/tailscale-x/tailscale-private-funnel/issues"><img src="/assets/icons/help-circle.svg" alt=""/>Support</a></div>
            </aside>
            <div class="pf-main">
                <header class="pf-topbar">
                    <button class="pf-menu" type="button" aria-label="Open navigation" aria-controls="pf-sidebar" aria-expanded="false" onclick="const open=this.getAttribute('aria-expanded') !== 'true'; document.getElementById('pf-sidebar').classList.toggle('pf-sidebar-open', open); document.getElementById('pf-sidebar').inert=!open; this.setAttribute('aria-expanded', String(open)); this.setAttribute('aria-label', open ? 'Close navigation' : 'Open navigation')"><img src="/assets/icons/menu-2.svg" alt=""/></button>
                    <div class="pf-topbar-context"><span class="pf-kicker">Control plane</span><strong>Local Funnel</strong></div>
                    <div class="pf-topbar-right"><span class="pf-health"><i class="pf-status-dot pf-status-ok"></i> Control plane online</span><span class="pf-identity"><img src="/assets/icons/user-circle.svg" alt=""/> Tailnet-only management</span></div>
                </header>
                <main class="pf-content" id="page-content" tabindex="-1">@templ.Raw(body)</main>
                <footer class="pf-footer"><span>Local Funnel · tailnet-only control plane</span><span><a href="https://github.com/tailscale-x/tailscale-private-funnel/blob/main/PRIVATE_FUNNEL.md">Docs</a><a href="/settings">Settings</a></span></footer>
            </div>
        </div>
        <script>
        (function(){const path=window.location.pathname,parent=document.querySelector('[data-node-navigation]')?.dataset.nodeNavigation;document.querySelectorAll('[data-nav]').forEach(function(a){if(a.dataset.nav==='/'?path==='/':a.dataset.nav===parent||path===a.dataset.nav||path.startsWith(a.dataset.nav+'/')||(a.dataset.nav==='/exposures'&&path==='/tailnet-exposures')||(a.dataset.nav==='/loadbalancers'&&path==='/enroll/loadbalancer')||(a.dataset.nav==='/gateways'&&path.startsWith('/enroll/')&&path!=='/enroll/loadbalancer')){a.classList.add('is-active');a.setAttribute('aria-current','page')}})})();
        const nav=document.getElementById('pf-sidebar'),navButton=document.querySelector('.pf-menu'),small=window.matchMedia('(max-width:1023px)');
        function syncNavigation(){nav.inert=small.matches&&!nav.classList.contains('pf-sidebar-open')};syncNavigation();small.addEventListener('change',syncNavigation);
        document.addEventListener('click',function(e){if(small.matches&&nav.classList.contains('pf-sidebar-open')&&!nav.contains(e.target)&&!navButton.contains(e.target)){nav.classList.remove('pf-sidebar-open');navButton.setAttribute('aria-expanded','false');navButton.setAttribute('aria-label','Open navigation');syncNavigation()}});
        document.addEventListener('keydown',function(e){if(e.key==='Escape'){const sidebar=document.getElementById('pf-sidebar'),menu=document.querySelector('.pf-menu');if(sidebar.classList.contains('pf-sidebar-open')){sidebar.classList.remove('pf-sidebar-open');menu.setAttribute('aria-expanded','false');menu.setAttribute('aria-label','Open navigation');sidebar.inert=window.innerWidth<1024;menu.focus()}}});
        </script>
    </body>
    </html>
}
