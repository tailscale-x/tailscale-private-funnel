{
  "name": "tailscale-private-funnel-ui",
  "private": true,
  "type": "module",
  "scripts": {
    "generate": "../scripts/generate-rpc.sh",
    "build": "tsc --noEmit && vite build && tailwindcss -i ./input.css -o ../internal/web/assets/app.css --minify && node ./copy-icons.mjs",
    "dev": "vite --host 127.0.0.1",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@bufbuild/protobuf": "2.16.0",
    "@connectrpc/connect": "2.2.0",
    "@connectrpc/connect-web": "2.2.0",
    "@scalar/api-reference": "1.75.0",
    "@tanstack/react-query": "5.104.3",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@bufbuild/protoc-gen-es": "2.16.0",
    "@tabler/icons": "3.48.0",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "daisyui": "5.0.50",
    "prettier": "3.6.2",
    "tailwindcss": "3.4.17",
    "typescript": "7.0.2",
    "vite": "8.3.4"
  }
}
